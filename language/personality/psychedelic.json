{
  "preset": "psychedelic",
  "version": 1,
  "description": "Playful register. NOTE: per design-system decision, psychedelia is NOT a mode of the chrome; this preset only raises playfulness in language. Flagged as a compatibility question below.",
  "params": {
    "formality": 0.3,
    "verbosity": 0.35,
    "humor_budget_per_conversation": 2,
    "signature_phrase_weight": 1.2,
    "exclamations_allowed": false,
    "emoji_mirror_only": true,
    "relationship_stage_min_for_slang": 2,
    "apology_max_per_incident": 1
  },
  "pack_overrides": {
    "general_chat": {
      "boost": [
        "core.humor.tidy",
        "core.humor.again",
        "core.humor.night"
      ]
    }
  }
}