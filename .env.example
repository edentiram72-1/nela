NELA_ENV=development
NELA_LOG_LEVEL=INFO
NELA_DATA_DIR=./data
NELA_PLUGIN_DIR=./plugins
NELA_ENABLE_VOICE=false
NELA_ENABLE_VISION=false
NELA_LANGUAGE_PERSONALITY=default
NELA_VOICE_AUTO_SPEAK_RESPONSES=true
NELA_VOICE_SILENT_MODE=true
NELA_VOICE_PROVIDER=macos_say
NELA_VOICE_PROFILE=nela_default
NELA_LLM_ENABLED=false
NELA_LLM_PROVIDER=openai
NELA_LLM_MODEL=gpt-5-mini
NELA_LLM_TIMEOUT_SECONDS=20
NELA_OPENAI_API_KEY=
